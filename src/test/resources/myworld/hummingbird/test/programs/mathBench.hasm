# Trivial numeric speed test, borrowed from https://github.com/DNS/benchmark-language/blob/master/test.java
# Converges towards 7051.571198
.symbols
    mathBench function $mathBench
            double
            parameters 0
            registers 9

.code
mathBench:
  # int i = 0;
  # double x = 1.0;
  # for(i = 0; i<99999999; i++){
  #   x = (i + i + 2 * i + 1 - 0.379)/x;
  # }
  # return x;
  # r0 = x
  # r2 = 1
  # r3 = 2
  # r4 = 0.379
  # r6 = 99999999
  # r7 = i
  # r8 = accumulator

  CONST r0, d1.0
  CONST r2, 1
  CONST r3, 2
  CONST r4, d0.379
  CONST r6, 99999999
  CONST r7, 0
  CONST r8, 0

  loop:
  IFGE r7, r6, $end # if i >= 99999999 goto $end
  MUL r8, r3, r7 # acc = 2 * i
  ADD r8, r8, r7 # acc = i + 2 * i
  ADD r8, r8, r7 # acc = i + i + 2 * i
  ADD r8, r8, r2 # acc = i + i + 2 * i + 1
  I2D r8, r8
  DSUB r8, r8, r4 # acc = i + i + 2 * i + 1 - 0.379
  DDIV r0, r8, r0 # x = (i + i + 2 * i + 1 - 0.379)/x
  ADD r7, r7, r2  # i++
  GOTO $$loop
  end:
  MRETURN r0, 2